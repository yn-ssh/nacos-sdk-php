{
    "name": "ssh/nacos-sdk-php",
    "description": "PHP SDK for Nacos service discovery and configuration",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "nacos",
        "service-discovery",
        "config-center",
        "webman",
        "workerman"
    ],
    "authors": [
        {
            "name": "ssh",
            "email": "694711507@qq.com"
        }
    ],
    "require": {
        "php": ">=8.0",
        "guzzlehttp/guzzle": "^6.0 || ^7.0",
        "psr/log": "^1.0 || ^2.0 || ^3.0",
        "symfony/options-resolver": "^5.0 || ^6.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.0 || ^9.0",
        "mockery/mockery": "^1.4",
        "friendsofphp/php-cs-fixer": "^3.0",
        "workerman/webman-framework": "^2.0"
    },
    "suggest": {
        "workerman/webman-framework": "Webman 框架支持，启用 NacosProcess/NacosService 等 Webman 组件"
    },
    "autoload": {
        "psr-4": {
            "Nacos\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nacos\\Tests\\": "tests/"
        }
    },
    "extra": {
        "webman": {
            "plugin": "Nacos\\Webman\\Plugin"
        }
    },
    "minimum-stability": "stable",
    "scripts": {
        "test": "phpunit",
        "cs-fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php"
    }
}